# ── Supabase ────────────────────────────────────────────────────────────────
# On Vercel, connect the Supabase project through the Supabase integration
# (Vercel → Integrations → Supabase) and these are injected under the
# integration's names (SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
# SUPABASE_SERVICE_ROLE_KEY, POSTGRES_URL); lib/db/env.ts accepts both. Set
# RENDERER_DB_PASSWORD there too and nothing below is needed by hand.
# The project must expose the `app` and `content` schemas to PostgREST.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Either the legacy service_role JWT, or a newer secret key as SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres (transaction pooler, port 6543; the app never prepares
# statements). The renderer uses a dedicated least-privilege role (see
# migration 0001) with SELECT on content.published_pages ONLY — never the
# service role, never a user JWT. There is no user on the public blog path.
# Either give RENDERER_DATABASE_URL, or RENDERER_DB_PASSWORD and the renderer
# URL is derived from DATABASE_URL/POSTGRES_URL with the user swapped.
DATABASE_URL=
RENDERER_DATABASE_URL=
RENDERER_DB_PASSWORD=

# ── App plane ───────────────────────────────────────────────────────────────
# Public URL of this deployment. Also the app's ONE canonical host in production:
# every other alias (Vercel hands out several) redirects here, so auth cookies
# always live where the sign-in callback reads them. Used in Slack links and
# the Worker's crawl endpoint too.
APP_URL=https://app.aeo.app
# Emails promoted to internal staff on sign-in (bootstrap for /ops). Comma-separated.
AEO_STAFF_EMAILS=
# Supabase Auth: add `${APP_URL}/auth/callback` to Authentication → URL Configuration → Redirect URLs,
# and enable the custom access token hook `app.custom_access_token_hook` under Authentication → Hooks.

# ── Jobs ───────────────────────────────────────────────────────────────────
# Inngest runs every long job (audits, syncs, the content pipeline). Connect
# the Vercel project from the Inngest dashboard; it sets both keys and syncs
# /api/inngest on every deploy. Without INNGEST_EVENT_KEY in production the
# public audit runs in-process after the response (up to 5 minutes) so the
# lead magnet still works; everything else waits for the keys.
# Settings → Deployment checks the endpoint, the scheduler heartbeat (site-health-monitor
# beats every 5 minutes) and a "Send a test event" round trip, and names the fix.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Inngest refuses to sync an app whose functions declare more concurrency than
# the plan allows (free plan: 5), and a refused sync runs nothing. Every
# function's global limit is capped at this; raise it after upgrading.
INNGEST_PLAN_CONCURRENCY=5
# Force the in-process audit path even when Inngest keys are present (debugging).
AEO_JOBS_INLINE=
# Model provider for briefs, drafts, fact extraction and the LLM-scored audit
# dimensions. OpenRouter is used when its key is set; the Anthropic API directly
# otherwise; AEO_LLM_PROVIDER=openrouter|anthropic forces one. No key = those
# steps report as degraded / not configured.
OPENROUTER_API_KEY=
# Optional: override the OpenRouter base URL (tests, a proxy).
OPENROUTER_BASE_URL=
ANTHROPIC_API_KEY=
AEO_LLM_PROVIDER=
# Per-task model ids. Anthropic spelling works for both providers
# ("claude-opus-5-5" → "anthropic/claude-opus-5.5" on OpenRouter); a full OpenRouter
# slug such as "openai/gpt-5" or "google/gemini-2.5-pro" is passed through.
# AEO_MODEL_DEFAULT overrides every task; the per-task ones override that.
# Defaults: claude-opus-5-5 (brief, draft), claude-sonnet-5-5 (QA judge,
# manifesto, profile, audit), claude-haiku-5-5 (fact extraction).
AEO_MODEL_DEFAULT=
AEO_MODEL_BRIEF=
AEO_MODEL_DRAFT=
AEO_MODEL_QA_JUDGE=
AEO_MODEL_FACTS_EXTRACT=
AEO_MODEL_MANIFEST_DRAFT=
AEO_MODEL_PROFILE=
AEO_AUDIT_MODEL=
# 1 = forward each task's effort to OpenRouter as reasoning.effort. Off by
# default: OpenRouter may turn it into a thinking budget, which Claude 5 rejects.
AEO_OPENROUTER_REASONING=
# 0 = turn off server-side refusal fallbacks on the direct Anthropic path
# (Opus 5.5, Opus 5, Sonnet 5.5). On by default.
AEO_ANTHROPIC_FALLBACKS=

# ── Spend governor (ops.budgets; Ops → Spend) ───────────────────────────────
# Every model call, SERP call and answer probe holds its estimated cost on the
# organisation's budget before it runs and settles at the actual cost; none
# starts once a budget is spent. Monthly caps a new organisation starts with
# (staff change them per org in Ops → Spend; the SERP cap is the org's own
# setting). A blank value keeps the default; a value above 99999999.99 (the
# most a cap holds) is taken as that.
# AEO_DEFAULT_LLM_MONTHLY_BUDGET_USD=200
# AEO_DEFAULT_ANSWER_PROBE_MONTHLY_BUDGET_USD=25
# Model spend one article (opportunity) may reach across all its attempts
# before the pipeline stops and asks a human. Asking for the article again
# (Write about this, Refresh now) starts its count over.
# AEO_ARTICLE_COST_CAP_USD=15
# off = admit every call and keep no holds (SERP calls fall back to the plain
# month-to-date check). For an incident, not for normal running.
AEO_SPEND_GOVERNOR=

# ── Publishing pace (lib/pipeline/guard.ts) ─────────────────────────────────
# Pages (new and refreshed) the pipeline publishes per site in any 7 days:
# 1.5× the site's weekly cadence over the last 90 days, at least 2, at most
# this ceiling (default 5). A run over the pace waits for a slot. A ceiling
# of 1 throttles every site to one a week.
# AEO_PUBLISH_VELOCITY_MAX=5

# ── SERP vendors (demand mining, AI Overview tracking) ─────────────────────
# DataForSEO: cheap bulk autocomplete, People Also Ask and rank tracking. Both
# login and password are required.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Optional per-call cost estimates for the budget guard when a response carries
# none. Defaults shown; a blank value keeps the default.
# DATAFORSEO_SERP_COST_USD=0.002
# DATAFORSEO_AUTOCOMPLETE_COST_USD=0.0006
# SerpApi: AI Overview citations (the overview JSON carries its references).
# SERPAPI_KEY is the deprecated name and is still read, with a warning.
SERPAPI_API_KEY=
# SERPAPI_SEARCH_COST_USD=0.01
# Which vendor answers AI Overview questions when both are set: serpapi
# (default) or dataforseo. A vendor that is not configured is ignored.
AEO_SERP_AIO_PROVIDER=

# ── AI answer probes (Strategy → Visibility → Engines) ─────────────────────
# Each sampled site's tracked prompts are asked of ChatGPT's, Perplexity's,
# Gemini's and Claude's models through OpenRouter (OPENROUTER_API_KEY above;
# nothing else), with web search on, every Tuesday. These are API-grounded
# probes, not the consumer apps, and are reported per engine, never added to
# the AI Overview or Profound numbers. Off per organisation until staff turn
# on "Answer probes" in Ops → Organisations; spend holds on the org's
# answer probe budget (AEO_DEFAULT_ANSWER_PROBE_MONTHLY_BUDGET_USD).
# JSON overrides per engine, or a new engine with every field:
#   {"chatgpt": {"model": "openai/gpt-5"}, "grok": {"model": "x-ai/grok-4", "label": "Grok via API (not the app)",
#    "search": "server_tool", "searchEngine": "native", "maxResults": 5, "maxTokens": 4000, "estimateUsd": 0.05}}
# search: server_tool | plugin | online_suffix | native_model | none. A value that does not validate stops the run.
AEO_ANSWER_ENGINES=
# Comma-separated engines to run (default: all of them).
AEO_ANSWER_ENGINES_ENABLED=
# Prompts per site (tracked, not excluded, pinned first, then by demand) and probes per prompt and engine.
# AEO_ANSWER_PANEL_SIZE=25
# AEO_ANSWER_SAMPLES=1

# ── Publishing / visibility integrations ───────────────────────────────────
# Webflow site API tokens are entered per project in the app (Vault-stored). Override the API base only for testing.
WEBFLOW_API_BASE=
# Profound Enterprise API keys are entered per project in the app. The base URL and endpoint paths are configurable per connection.

# ── Billing / email ─────────────────────────────────────────────────────────
# Stripe: hosted Checkout + Billing Portal; the webhook is the source of truth for plan state.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MANAGED=
# Resend: invites and site-health alert emails. Both unset = emails are skipped, never errors.
RESEND_API_KEY=
ALERT_EMAIL_FROM="AEO Platform <alerts@example.com>"

# ── Edge / proxy ────────────────────────────────────────────────────────────
# Wildcard host that customer proxies point at. Every site gets a
# non-guessable subdomain of this. MUST NEVER appear in rendered output.
AEO_EDGE_DOMAIN=blogedge.aeo.app
# Absolute CDN origin for /_next/static assets (see next.config.ts).
NEXT_PUBLIC_ASSET_PREFIX=
# R2 static mirror the customer Worker falls back to when we 5xx.
AEO_MIRROR_ORIGIN=https://mirror.aeo.app
# Legacy global HMAC secret; each site now carries its own (app.sites.proxy_hmac_secret).
AEO_PROXY_HMAC_SECRET=
# Salt for hashing crawler source addresses in analytics.crawl_events (never stored raw).
AEO_IP_HASH_SALT=

# ── Connectors
# Signed OAuth `state` for every provider (≥16 chars). Callbacks trust this, not a session.
OAUTH_STATE_SECRET=
# Slack app: Events API + interactivity request URLs point at /api/webhooks/slack and /api/webhooks/slack/interactions.
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://app.example.com/api/connectors/slack/callback
# Google OAuth client (Search Console + GA4, read-only scopes).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://app.example.com/api/connectors/google/callback
