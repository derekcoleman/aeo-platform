# ── Supabase ────────────────────────────────────────────────────────────────
# On Vercel, connect the Supabase project through the Supabase integration
# (Vercel → Integrations → Supabase) and these are injected under the
# integration's names (SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
# SUPABASE_SERVICE_ROLE_KEY, POSTGRES_URL); lib/db/env.ts accepts both. Set
# RENDERER_DB_PASSWORD there too and nothing below is needed by hand.
# The project must expose the `app` and `content` schemas to PostgREST.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres (transaction pooler, port 6543; the app never prepares
# statements). The renderer uses a dedicated least-privilege role (see
# migration 0001) with SELECT on content.published_pages ONLY — never the
# service role, never a user JWT. There is no user on the public blog path.
# Either give RENDERER_DATABASE_URL, or RENDERER_DB_PASSWORD and the renderer
# URL is derived from DATABASE_URL/POSTGRES_URL with the user swapped.
DATABASE_URL=
RENDERER_DATABASE_URL=
RENDERER_DB_PASSWORD=

# ── App plane ───────────────────────────────────────────────────────────────
# Public URL of this deployment; used in Slack links and the Worker's crawl endpoint.
APP_URL=https://app.aeo.app
# Emails promoted to internal staff on sign-in (bootstrap for /ops). Comma-separated.
AEO_STAFF_EMAILS=
# Supabase Auth: add `${APP_URL}/auth/callback` to Authentication → URL Configuration → Redirect URLs,
# and enable the custom access token hook `app.custom_access_token_hook` under Authentication → Hooks.

# ── Edge / proxy ────────────────────────────────────────────────────────────
# Wildcard host that customer proxies point at. Every site gets a
# non-guessable subdomain of this. MUST NEVER appear in rendered output.
AEO_EDGE_DOMAIN=blogedge.aeo.app
# Absolute CDN origin for /_next/static assets (see next.config.ts).
NEXT_PUBLIC_ASSET_PREFIX=
# R2 static mirror the customer Worker falls back to when we 5xx.
AEO_MIRROR_ORIGIN=https://mirror.aeo.app
# HMAC secret used to sign customer Worker -> origin requests.
AEO_PROXY_HMAC_SECRET=

# ── Connectors
# Signed OAuth `state` for every provider (≥16 chars). Callbacks trust this, not a session.
OAUTH_STATE_SECRET=
# Slack app: Events API + interactivity request URLs point at /api/webhooks/slack and /api/webhooks/slack/interactions.
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://app.example.com/api/connectors/slack/callback
# Google OAuth client (Search Console + GA4, read-only scopes).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://app.example.com/api/connectors/google/callback
