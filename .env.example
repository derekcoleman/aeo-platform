# ── Supabase ────────────────────────────────────────────────────────────────
# On Vercel, connect the Supabase project through the Supabase integration
# (Vercel → Integrations → Supabase) and these are injected under the
# integration's names (SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
# SUPABASE_SERVICE_ROLE_KEY, POSTGRES_URL); lib/db/env.ts accepts both. Set
# RENDERER_DB_PASSWORD there too and nothing below is needed by hand.
# The project must expose the `app` and `content` schemas to PostgREST.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres (transaction pooler, port 6543; the app never prepares
# statements). The renderer uses a dedicated least-privilege role (see
# migration 0001) with SELECT on content.published_pages ONLY — never the
# service role, never a user JWT. There is no user on the public blog path.
# Either give RENDERER_DATABASE_URL, or RENDERER_DB_PASSWORD and the renderer
# URL is derived from DATABASE_URL/POSTGRES_URL with the user swapped.
DATABASE_URL=
RENDERER_DATABASE_URL=
RENDERER_DB_PASSWORD=

# ── App plane ───────────────────────────────────────────────────────────────
# Public URL of this deployment. Also the app's ONE canonical host in production:
# every other alias (Vercel hands out several) redirects here, so auth cookies
# always live where the sign-in callback reads them. Used in Slack links and
# the Worker's crawl endpoint too.
APP_URL=https://app.aeo.app
# Emails promoted to internal staff on sign-in (bootstrap for /ops). Comma-separated.
AEO_STAFF_EMAILS=
# Supabase Auth: add `${APP_URL}/auth/callback` to Authentication → URL Configuration → Redirect URLs,
# and enable the custom access token hook `app.custom_access_token_hook` under Authentication → Hooks.

# ── Jobs ───────────────────────────────────────────────────────────────────
# Inngest runs every long job (audits, syncs, the content pipeline). Connect
# the Vercel project from the Inngest dashboard; it sets both keys and syncs
# /api/inngest on every deploy. Without INNGEST_EVENT_KEY in production the
# public audit runs in-process after the response (up to 5 minutes) so the
# lead magnet still works; everything else waits for the keys.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Force the in-process audit path even when Inngest keys are present (debugging).
AEO_JOBS_INLINE=
# Model provider for briefs, drafts, fact extraction and the LLM-scored audit
# dimensions. OpenRouter is used when its key is set; the Anthropic API directly
# otherwise; AEO_LLM_PROVIDER=openrouter|anthropic forces one. No key = those
# steps report as degraded / not configured.
OPENROUTER_API_KEY=
# Optional: override the OpenRouter base URL (tests, a proxy).
OPENROUTER_BASE_URL=
ANTHROPIC_API_KEY=
AEO_LLM_PROVIDER=
# Per-task model ids. Anthropic spelling works for both providers
# ("claude-opus-5" → "anthropic/claude-opus-5" on OpenRouter); a full OpenRouter
# slug such as "openai/gpt-5" or "google/gemini-2.5-pro" is passed through.
# AEO_MODEL_DEFAULT overrides every task; the per-task ones override that.
AEO_MODEL_DEFAULT=
AEO_MODEL_BRIEF=
AEO_MODEL_DRAFT=
AEO_MODEL_QA_JUDGE=
AEO_MODEL_FACTS_EXTRACT=
AEO_MODEL_MANIFEST_DRAFT=
AEO_AUDIT_MODEL=

# ── Publishing / visibility integrations ───────────────────────────────────
# Webflow site API tokens are entered per project in the app (Vault-stored). Override the API base only for testing.
WEBFLOW_API_BASE=
# Profound Enterprise API keys are entered per project in the app. The base URL and endpoint paths are configurable per connection.

# ── Billing / email ─────────────────────────────────────────────────────────
# Stripe: hosted Checkout + Billing Portal; the webhook is the source of truth for plan state.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MANAGED=
# Resend: invites and site-health alert emails. Both unset = emails are skipped, never errors.
RESEND_API_KEY=
ALERT_EMAIL_FROM="AEO Platform <alerts@example.com>"

# ── Edge / proxy ────────────────────────────────────────────────────────────
# Wildcard host that customer proxies point at. Every site gets a
# non-guessable subdomain of this. MUST NEVER appear in rendered output.
AEO_EDGE_DOMAIN=blogedge.aeo.app
# Absolute CDN origin for /_next/static assets (see next.config.ts).
NEXT_PUBLIC_ASSET_PREFIX=
# R2 static mirror the customer Worker falls back to when we 5xx.
AEO_MIRROR_ORIGIN=https://mirror.aeo.app
# Legacy global HMAC secret; each site now carries its own (app.sites.proxy_hmac_secret).
AEO_PROXY_HMAC_SECRET=
# Salt for hashing crawler source addresses in analytics.crawl_events (never stored raw).
AEO_IP_HASH_SALT=

# ── Connectors
# Signed OAuth `state` for every provider (≥16 chars). Callbacks trust this, not a session.
OAUTH_STATE_SECRET=
# Slack app: Events API + interactivity request URLs point at /api/webhooks/slack and /api/webhooks/slack/interactions.
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://app.example.com/api/connectors/slack/callback
# Google OAuth client (Search Console + GA4, read-only scopes).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://app.example.com/api/connectors/google/callback
